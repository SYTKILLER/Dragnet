# ===== 罗网 Dragnet =====
# 原则：仅上传最小项目内容（源码、配置、必需资源）。
# 开发期间产生的文档、截图、临时产物一律不入库。

# ---- 开发文档 ----
docs/
doc/
notes/
*.doc
*.docx
*.pdf
*.ppt
*.pptx
*.xls
*.xlsx
*.wps

# 截图 / 草图目录
screenshots/
screens/
snips/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo

# ---- 构建产物 / 依赖 ----
build/
dist/
out/
target/
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 日志 / 缓存 / 临时文件 ----
*.log
logs/
.cache/
tmp/
*.tmp
*.bak

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- 凭据 / 密钥 ----
.env
*.pem
*.key
